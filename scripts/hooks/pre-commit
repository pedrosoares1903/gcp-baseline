#!/usr/bin/env bash
set -euo pipefail

# Só os ficheiros .tf que estão mesmo a ser commitados (Added/Copied/Modified).
files=$(git diff --cached --name-only --diff-filter=ACM -- '*.tf')
[ -z "$files" ] && exit 0

if ! terraform fmt -check -list=true $files > /dev/null 2>&1; then
  echo ""
  echo "  Formatacao por arrumar nestes ficheiros:"
  terraform fmt -check -list=true $files | sed 's/^/    /'
  echo ""
  echo "  Corrige com:   terraform fmt -recursive"
  echo "  (ou ignora este aviso com:  git commit --no-verify)"
  echo ""
  exit 1
fi